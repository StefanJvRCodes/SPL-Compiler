glob { 
    globalnum1 
    globalnum2 
    flag 
} 
proc { 
    addnums ( a b ) { 
        local { sum temp } 
        sum = a ; 
        temp = b ; 
        print sum ; 
        print temp 
    }
    
    setflag ( value ) {
        local { }
        flag = value
    }
} 
func { 
    multiply ( x y ) { 
        local { result } 
        result = x ; 
        return result 
    }
} 
main { 
    var { 
        mainvar1 
        mainvar2 
        counter 
    } 
    mainvar1 = 100 ;
    mainvar2 = globalnum1 ;
    counter = 5 ;
    print mainvar1 ;
    print mainvar2 ; 
    print counter ;
    print 42 ;
    mainvar1 = counter ;
    print mainvar1 ;
    halt 
}